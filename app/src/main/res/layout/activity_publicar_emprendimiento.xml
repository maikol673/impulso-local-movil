<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f9f9f9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título  -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Publicar Nuevo Emprendimiento"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_gravity="center"
            android:layout_marginBottom="30dp" />

        <!-- Formulario  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#f9f9f9"
            android:padding="30dp"
            android:elevation="2dp">

            <!-- Campo Nombre  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Emprendimiento:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre de tu emprendimiento"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_editartexto" />

            <!-- Campo Descripción  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe tu emprendimiento..."
                android:minHeight="100dp"
                android:gravity="top"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_editartexto"
                android:inputType="textMultiLine" />

            <!-- Campo Categoría  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <Spinner
                android:id="@+id/spinnerCategoria"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_editartexto" />

            <!-- Campo Ubicación  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubicación:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/etUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ciudad, Departamento"
                android:padding="12dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_editartexto" />

            <!-- Campo Imagen  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subir imagen del emprendimiento:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <Button
                android:id="@+id/btnSeleccionarImagen"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Seleccionar archivo"
                android:backgroundTint="#e0e0e0"
                android:textColor="#333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNombreArchivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ningún archivo seleccionado"
                android:textSize="12sp"
                android:textColor="#666"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Formatos aceptados: JPG, PNG, GIF. Tamaño máximo: 5MB"
                android:textSize="11sp"
                android:textColor="#666"
                android:layout_marginBottom="20dp" />

            <!-- Campo Estado -  -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <Spinner
                android:id="@+id/spinnerEstado"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:padding="12dp"
                android:layout_marginBottom="25dp"
                android:background="@drawable/bg_editartexto" />

            <!-- Botones  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnPublicar"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="📢 Publicar Emprendimiento"
                    android:backgroundTint="#28a745"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp" />

                <TextView
                    android:id="@+id/tvCancelar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancelar"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_marginStart="15dp"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>