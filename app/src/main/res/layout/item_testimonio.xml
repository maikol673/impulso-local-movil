<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#f8f9fa"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <TextView
        android:id="@+id/tvTestimonioContenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Este ecosistema me ayudó a conectar con inversionistas para mi startup"
        android:textSize="14sp"
        android:textColor="#212529"
        android:lineHeight="22sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12sp">

        <TextView
            android:id="@+id/tvTestimonioAutor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="- Ana L., Fundadora de TechSolution"
            android:textSize="12sp"
            android:textColor="#6c757d"
            android:fontStyle="italic" />

        <Button
            android:id="@+id/btnEliminarTestimonio"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🗑️ Eliminar"
            android:backgroundTint="@color/error"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>