<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8f9fa"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HERO SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:background="@drawable/bg_hero_gradient">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Impulsa tu emprendimiento al siguiente nivel"
                android:textSize="24sp"
                android:textColor="#2a5bdc"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="15dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conecta, aprende y crece con nuestra comunidad de emprendedores innovadores"
                android:textSize="14sp"
                android:textColor="#6c757d"
                android:gravity="center" />

        </LinearLayout>

        <!-- ACCIONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="40dp"
            android:background="#f8f9fa"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué deseas hacer?"
                android:textSize="22sp"
                android:textColor="#2a5bdc"
                android:textStyle="bold"
                android:layout_marginBottom="25dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="25dp">

                <TextView
                    android:id="@+id/btnVerEmprendimientos"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Ver Emprendimientos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_boton_primary"
                    android:gravity="center"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btnPublicar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Publicar Emprendimiento"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_boton_secondary"
                    android:gravity="center"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- FEATURES (Beneficios) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="40dp"
            android:background="#f8f9fa">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuestros Beneficios"
                android:textSize="22sp"
                android:textColor="#2a5bdc"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="true">

                <!-- Card Crecimiento -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCrecimiento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📞"
                            android:textSize="36sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Crecimiento"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#212529"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Herramientas para escalar tu negocio de manera sostenible"
                            android:textSize="11sp"
                            android:textColor="#6c757d"
                            android:gravity="center"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Card Networking -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNetworking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡"
                            android:textSize="36sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Networking"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#212529"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Conecta con mentores y otros emprendedores"
                            android:textSize="11sp"
                            android:textColor="#6c757d"
                            android:gravity="center"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Card Formación -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFormacion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔍"
                            android:textSize="36sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Formación"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#212529"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cursos especializados para cada etapa de tu negocio"
                            android:textSize="11sp"
                            android:textColor="#6c757d"
                            android:gravity="center"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Espacio para mantener grid 2x2 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:visibility="invisible" />

            </GridLayout>

        </LinearLayout>

        <!-- TESTIMONIOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="40dp"
            android:background="@android:color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lo que dicen nuestros miembros"
                android:textSize="22sp"
                android:textColor="#2a5bdc"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="30dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#f8f9fa"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Este ecosistema me ayudó a conectar con inversionistas para mi startup"
                    android:textSize="14sp"
                    android:textColor="#212529"
                    android:lineHeight="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- Ana L., Fundadora de TechSolution"
                    android:textSize="12sp"
                    android:textColor="#6c757d"
                    android:layout_marginTop="12sp"
                    android:fontStyle="italic" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#f8f9fa"
                android:padding="20dp"
                android:layout_marginBottom="24dp"
                android:baselineAligned="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Los cursos me dieron las herramientas para triplicar mis ventas"
                    android:textSize="14sp"
                    android:textColor="#212529"
                    android:lineHeight="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- Carlos M., Dueño de Panadería Dulce"
                    android:textSize="12sp"
                    android:textColor="#6c757d"
                    android:layout_marginTop="12sp"
                    android:fontStyle="italic" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnAgregarTestimonio"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📝 Compartir mi experiencia"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_boton_primary"
                android:gravity="center"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>